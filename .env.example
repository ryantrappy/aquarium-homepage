# Copy to .env (git-ignored) next to deploy/compose.yaml usage:
#   docker compose --env-file .env -f deploy/compose.yaml up -d --build
# Compose substitutes these into deploy/compose.yaml; unset values use the defaults shown.

# --- Compose / host settings ---
# Host directory holding reef-config.json (must be writable by uid 1000, the container's "node" user).
REEF_DATA_DIR=../data
# Host address:port published for the reverse proxy. Keep 127.0.0.1 unless you want direct LAN access.
REEF_BIND=127.0.0.1
REEF_HOST_PORT=3004

# --- App settings (passed into the container) ---
# Exact browser origin used to reach the app. Config writes (PUT) from other origins are rejected.
REEF_PUBLIC_ORIGIN=https://aquarium.example.com
# Host path of the Intel coretemp device, mounted read-only. Compose fails to start if it is missing.
REEF_CPU_SENSOR_HOST_PATH=/sys/devices/platform/coretemp.0

# --- Set automatically in the image/compose; only override when running without Docker ---
# Where the shared service list is persisted. Default in Docker: /var/lib/reef-control/reef-config.json
# REEF_CONFIG_PATH=.data/reef-config.json
# Path read by the CPU temperature API. Default in Docker: /run/host-sensors/coretemp.0
# REEF_CPU_HWMON_ROOT=/sys/devices/platform/coretemp.0

# --- Optional network traffic source (all three required; requires a read-only mount of the stats dir) ---
# REEF_NETWORK_SOURCE_ID=eth0
# REEF_NETWORK_SOURCE_LABEL=Main uplink
# REEF_NETWORK_STATS_ROOT=/run/host-sensors/net/eth0/statistics
